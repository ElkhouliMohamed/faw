# Copier vers .env et renseigner les valeurs. Ne jamais commiter le fichier .env.
# Laisser les secrets vides dans ce fichier d'exemple.
# Générer APP_KEY en local : php artisan key:generate

APP_NAME="FAW Aluminium"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:3100
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_COOKIE=faw_filament_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Mot de passe du compte propriétaire (php artisan faw:owner). Uniquement dans .env.
FILAMENT_ADMIN_PASSWORD=

# Devis automatique (chemins à adapter sur chaque machine)
PYTHON_BIN=python3
DEVIS_GENERATOR_SCRIPT=/path/to/devis/generer_devis.py
DEVIS_COUNTER_SCRIPT=/path/to/devis/prochain_numero.py
DEVIS_JOURNAL_PATH=/path/to/devis/journal-devis.csv
DEVIS_OUTPUT_DIR=storage/app/private/devis

# E-mail des devis (Resend). Désactivé si RESEND_API_KEY est vide.
RESEND_API_KEY=
QUOTE_EMAIL_FROM=
QUOTE_EMAIL_REPLY_TO=faw@faw.ma

# Le paiement par carte (CMI) se configure dans Filament, pas ici.
# Il doit rester désactivé tant que Walfar ne l'a pas autorisé explicitement.

# --- Optionnel : mail générique Laravel (inutilisé si l'envoi passe par Resend) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Optionnel : Redis / AWS / services tiers (laisser vide si non utilisés) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME="${APP_NAME}"

# Portail client / commandes : e-mail de l'équipe (acceptations, demandes de modification, preuves de virement)
# et adresse de retrait affichée aux clients.
FAW_TEAM_EMAIL=
FAW_PICKUP_ADDRESS=
# Coordonnées bancaires pour le virement (renseignées UNIQUEMENT dans .env, jamais dans le code ni git).
FAW_BANK_HOLDER=
FAW_BANK_NAME=
FAW_BANK_BRANCH=
FAW_BANK_RIB=
FAW_BANK_IBAN=
FAW_BANK_SWIFT=
