# Copier vers .env et renseigner les valeurs. Ne jamais commiter le fichier .env.
# Laisser les secrets vides dans ce fichier d'exemple.
# Générer APP_KEY en local : php artisan key:generate

APP_NAME="FAW Aluminium"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:3100
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# PostgreSQL (local : docker compose up -d à la racine du dépôt, voir DEV-SETUP.md).
# DB_PASSWORD est volontairement vide : en local (Docker uniquement), mettre le mot de passe indiqué dans
# DEV-SETUP.md ; en production, une valeur forte dans .env seulement (jamais dans ce fichier).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=faw
DB_USERNAME=faw
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_COOKIE=faw_filament_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=database
CACHE_PREFIX=faw
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Mot de passe du compte propriétaire (php artisan faw:owner). Uniquement dans .env.
FILAMENT_ADMIN_PASSWORD=

# Devis automatique (chemins à adapter sur chaque machine)
PYTHON_BIN=python3
DEVIS_GENERATOR_SCRIPT=/path/to/devis/generer_devis.py
DEVIS_COUNTER_SCRIPT=/path/to/devis/prochain_numero.py
DEVIS_JOURNAL_PATH=/path/to/devis/journal-devis.csv
DEVIS_OUTPUT_DIR=storage/app/private/devis

# E-mail des devis (Resend). Désactivé si RESEND_API_KEY est vide.
RESEND_API_KEY=
QUOTE_EMAIL_FROM=
QUOTE_EMAIL_REPLY_TO=faw@faw.ma

# Le paiement par carte (CMI) se configure dans Filament, pas ici.
# Il doit rester désactivé tant que Walfar ne l'a pas autorisé explicitement.

# --- Mail générique Laravel : Mailpit en local (interface http://localhost:8025) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@faw.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Redis (service docker compose) ---
# Pour l'utiliser comme cache / sessions / file d'attente : extension phpredis (REDIS_CLIENT=phpredis)
# ou paquet predis/predis (REDIS_CLIENT=predis), puis CACHE_STORE=redis, SESSION_DRIVER=redis, QUEUE_CONNECTION=redis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Optionnel : AWS / services tiers (laisser vide si non utilisés) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME="${APP_NAME}"

# Portail client / commandes : e-mail de l'équipe (acceptations, demandes de modification, preuves de virement)
# et adresse de retrait affichée aux clients.
FAW_TEAM_EMAIL=
FAW_PICKUP_ADDRESS=
# Coordonnées bancaires pour le virement (renseignées UNIQUEMENT dans .env, jamais dans le code ni git).
FAW_BANK_HOLDER=
FAW_BANK_NAME=
FAW_BANK_BRANCH=
FAW_BANK_RIB=
FAW_BANK_IBAN=
FAW_BANK_SWIFT=
# Origine publique de la boutique (URL de retour et de notification du paiement CMI). Vide : APP_URL.
FAW_SHOP_URL=

# Boutique Next : rafraîchissement immédiat du cache après une modification dans Filament.
# URL interne de la boutique (ex. http://127.0.0.1:3100/revalidate) et secret partagé (32 caractères minimum,
# identique à REVALIDATE_SECRET dans faw-shop/.env.local). Vide : la boutique se met à jour à l'expiration du cache (1 à 5 min).
SHOP_REVALIDATE_URL=
SHOP_REVALIDATE_SECRET=
