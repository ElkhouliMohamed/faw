# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/
/tmp/

# production
/build

# misc
.DS_Store
*.pem

# logs and process leftovers
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.server.pid
.tunnel.pid

# env files — never commit secrets; only the example is tracked
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases, customer quotes, uploads, screenshots
prisma/*.db
prisma/*.db-journal
/data/devis/
/data/uploads/
/data/redirects.json
/data/redirect-hits.json
/shots/
