# Copier vers .env.local et renseigner les valeurs. Ne jamais commiter .env.local.
# Laisser les secrets vides dans ce fichier d'exemple.

# --- Base ---
DATABASE_URL="file:./prisma/dev.db"
LARAVEL_DATABASE_URL="file:../faw-api/database/database.sqlite"
LARAVEL_ORIGIN="http://127.0.0.1:8000"
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
NEXT_PUBLIC_NOINDEX="1"

# --- Admin (secrets : uniquement dans .env.local) ---
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
SETTINGS_ENCRYPTION_KEY=
ADMIN_SESSION_HOURS="8"
ADMIN_MAX_FAILS="5"
ADMIN_LOCK_MINUTES="15"
ADMIN_COOKIE_SECURE=

# --- Formulaires / anti-spam ---
FORM_SECRET=
FORM_RATE_LIMIT="8"
FORM_RATE_WINDOW_MS="600000"
FORM_MIN_FILL_MS="3000"
TRUST_PROXY="1"
SERVER_ACTIONS_ALLOWED_ORIGINS=
UPLOAD_DIR=
REDIRECTS_FILE=
REDIRECT_HITS_FILE=
FAW_EVENTS=

# --- Devis automatique (chemins à adapter sur chaque machine, jamais de chemin d'une autre machine) ---
PYTHON_BIN="python3"
DEVIS_GENERATOR_SCRIPT="/path/to/devis/generer_devis.py"
DEVIS_COUNTER_SCRIPT="/path/to/devis/prochain_numero.py"
DEVIS_JOURNAL_PATH="/path/to/devis/journal-devis.csv"
DEVIS_MESSAGE_PATH=
DEVIS_OUTPUT_DIR="./data/devis"
DEVIS_SOURCE_DIR=
FAW_TEST=

# --- Lien privé du client ---
QUOTE_PUBLIC_BASE_URL=
QUOTE_LINK_RATE_LIMIT="60"
QUOTE_SALESPERSON=

# --- E-mail automatique du devis (Resend) : désactivé si RESEND_API_KEY est vide. Voir RESEND-SETUP.md ---
RESEND_API_KEY=
QUOTE_EMAIL_FROM=
QUOTE_EMAIL_REPLY_TO="faw@faw.ma"
QUOTE_EMAIL_BCC=
RESEND_API_BASE_URL="https://api.resend.com"
QUOTE_EMAIL_RESEND_MIN_SECONDS="20"

# --- SEO / mesure / réseaux (affichés uniquement si renseignés ; IDs aussi configurables dans Filament) ---
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# --- Scripts de test optionnels (ne pas y mettre de mot de passe) ---
# BASE="http://127.0.0.1:3100"
# TEST_FRONT_ORIGIN="http://127.0.0.1:3101"
# TEST_API_ORIGIN="http://127.0.0.1:8001"
