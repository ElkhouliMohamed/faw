// Demandes de commande (leads) + mini-CRM. Pas de paiement en ligne. SQLite local.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contact {
  id             Int           @id @default(autoincrement())
  phone          String        @unique // normalisé +2126XXXXXXXX
  name           String
  email          String?
  city           String?
  type           String        @default("particulier") // particulier | entreprise
  company        String?
  ice            String?
  tags           String        @default("") // liste séparée par des virgules
  // attribution du premier contact
  source         String? // site | manuel | whatsapp | téléphone | visite
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  gclid          String?
  fbclid         String?
  landing        String?
  referrer       String?
  createdAt      DateTime      @default(now())
  lastActivityAt DateTime      @default(now())
  orders         Order[]
  quotes         Quote[]
  interactions   Interaction[]
  tasks          Task[]
}

model Order {
  id            Int         @id @default(autoincrement())
  number        String      @unique
  createdAt     DateTime    @default(now())
  status        String      @default("nouveau") // nouveau | contacté | devis envoyé | gagné | perdu
  origin        String      @default("site") // site | manuel
  locale        String      @default("fr")
  contactId     Int?
  contact       Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  customerName  String
  phone         String
  email         String?
  city          String
  address       String
  company       String?
  ice           String?
  deliveryMode  String // casablanca | rabat | autre | livraison | retrait | transporteur | n/a
  deliveryFee   Int // DH TTC
  deliveryNote  String?
  paymentMethod String // virement | cheque | reception | à définir
  notes         String?
  subtotal      Int // DH TTC
  total         Int // DH TTC (valeur du lead)
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  gclid         String?
  fbclid        String?
  quoteRefusal  String? // raisons du refus automatique de devis (lead à traiter par Walfar)
  couponCode     String?
  couponDiscount Int     @default(0) // DH TTC déduits par le code promo
  cartId         String? // panier d'origine (paniers abandonnés)
  items         OrderItem[]
  events        LeadEvent[]
  quotes        Quote[]
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  title     String
  category  String
  unitPrice Int
  quantity  Int
  lineTotal Int
}

model LeadEvent {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  createdAt  DateTime @default(now())
}

model Interaction {
  id        Int      @id @default(autoincrement())
  contactId Int
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String // appel | whatsapp | visite | devis | note
  note      String?
  createdAt DateTime @default(now())
}

model Task {
  id        Int       @id @default(autoincrement())
  contactId Int
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Catalogue (back-office « Stock »). Initialisé depuis data/products.json sans modification.
model Product {
  id               String   @id // référence, ex. CF-EI60-90
  slug             String   @unique
  title            String
  seoTitle         String
  description      String
  shortDescription String?
  price            Int // DH TTC (0 = prix manquant)
  category         String // libellé de catégorie
  brand            String   @default("FAW Aluminium")
  image            String?
  availability     String   @default("en stock") // en stock | bientôt disponible | indisponible | sur commande
  stockQty         Int? // null = non suivi
  priceToConfirm   Boolean  @default(false)
  stockToConfirm   Boolean  @default(false)
  stockNote        String?
  variantGroup     String? // fiches sœurs (sélecteur de taille)
  variantLabel     String? // ex. « 90 cm »
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)
  // SEO + catalogue étendu (back-office « Produits »)
  metaTitle        String   @default("")
  metaDescription  String   @default("")
  badges           String   @default("") // ids de badges séparés par des virgules
  warrantyId       Int?
  attributes       String   @default("{}") // JSON { cléAttribut: valeur }
  salesMode        String   @default("quote_only") // stocké, inerte tant que les prix sont masqués
  h1               String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Devis PDF générés automatiquement (numéro issu du compteur Meta Closer).
model Quote {
  id           Int       @id @default(autoincrement())
  number       String? // réservé par prochain_numero.py UNIQUEMENT à la validation par l'équipe
  status       String    @default("à valider") // à valider | validé | envoyé | refusé
  createdAt    DateTime  @default(now())
  orderId      Int?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  contactId    Int?
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  clientName   String
  clientType   String    @default("particulier")
  phone        String    @default("")
  city         String
  totalHt      Float
  totalTtc     Int
  transport    String
  lines        String // JSON
  genInput     String    @default("{}") // JSON entrée du générateur (sans numéro ni date)
  journalInput String    @default("{}") // JSON nom / produits / ville pour la ligne de journal
  note         String?
  pdfFile      String? // PDF définitif (après validation) dans DEVIS_OUTPUT_DIR
  token        String    @unique // ancien jeton : ne contient plus que l’empreinte (jamais le lien en clair)
  tokenHash      String?   @unique // sha256 du jeton du lien privé (géré par Laravel)
  tokenExpiresAt DateTime? // expiration du lien privé
  tokenRevokedAt DateTime? // lien révoqué depuis Filament
  versionNumber  String? // numéro affiché de la version courante (643, puis 643-2…), géré par Laravel
  journaled    Boolean   @default(false) // ligne ajoutée au journal (à l'envoi)
  validatedAt  DateTime?
  sentAt       DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  // Envoi automatique par e-mail (Resend), uniquement au clic « Valider » de l'équipe
  email              String? // e-mail du client (validé zod au formulaire)
  emailStatus        String? // envoyé | échec | null (jamais tenté)
  emailSentAt        DateTime?
  emailMessageId     String?
  emailError         String?
  emailAttempts      Int       @default(0)
  emailLastAttemptAt DateTime?
  deliveredVia       String? // email | manuel

  @@index([number])
  @@index([status])
}

/* ============================ Back-office modulaire ============================ */

/// Utilisateurs du back-office (ADMIN_PASSWORD reste l'accès propriétaire de secours).
model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  role         String    @default("viewer") // admin | manager | viewer
  passwordHash String // scrypt:N:r:p:sel:hash (jamais de mot de passe en clair)
  active       Boolean   @default(true)
  failedCount  Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Journal des actions admin.
model AuditLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  actor    String
  action   String // create | update | delete | login | logout | settings | ...
  entity   String
  entityId String?
  summary  String?

  @@index([at])
}

/// Réglages clé/valeur (JSON). Les secrets sont chiffrés (AES-256-GCM) et jamais renvoyés au navigateur.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Media {
  id           Int      @id @default(autoincrement())
  file         String   @unique
  url          String
  alt          String   @default("")
  width        Int?
  height       Int?
  size         Int
  originalName String?
  createdAt    DateTime @default(now())
}

model Category {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  label          String   @unique
  short          String   @default("")
  family         String // portes-coupe-feu | galandage | automatisme | incendie (règles livraison / devis)
  description    String   @default("")
  seoTitle       String   @default("")
  seoDescription String   @default("")
  image          String?
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  warrantyId     Int?
  parentId       Int? // catégorie parente (Laravel, additif)
  h1             String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Attribute {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  label       String
  unit        String   @default("")
  kind        String   @default("text") // text | number | select
  options     String   @default("") // une option par ligne (select)
  sortOrder   Int      @default(0)
  showInSpecs Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Badge {
  id        Int      @id @default(autoincrement())
  label     String   @unique
  tone      String   @default("neutral") // neutral | copper | success | warning | dark
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Warranty {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  text      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bundle {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  title          String
  description    String   @default("")
  image          String?
  items          String // JSON [{ id, qty }]
  price          Int // prix du pack DH TTC
  active         Boolean  @default(false)
  sortOrder      Int      @default(0)
  seoTitle       String   @default("")
  seoDescription String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Promotion {
  id        Int       @id @default(autoincrement())
  name      String
  kind      String // percent | fixed
  value     Int
  scope     String // all | category | product
  targets   String    @default("") // slugs de catégories ou références produits, séparés par des virgules
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Coupon {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  kind       String // percent | fixed
  value      Int
  minOrder   Int       @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  usageLimit Int?
  usedCount  Int       @default(0)
  active     Boolean   @default(false)
  note       String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Popup {
  id            Int       @id @default(autoincrement())
  name          String
  kind          String // promo | newsletter | whatsapp
  title         String
  body          String    @default("")
  ctaLabel      String    @default("")
  ctaUrl        String    @default("")
  trigger       String    @default("delay") // delay | scroll | exit
  delaySeconds  Int       @default(8)
  scrollPercent Int       @default(50)
  paths         String    @default("") // préfixes de chemin séparés par des virgules (vide = tout le site)
  frequency     String    @default("session") // once | session | days
  frequencyDays Int       @default(7)
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  consent   Boolean
  source    String?
  createdAt DateTime @default(now())
}

model LandingPage {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  title          String
  seoTitle       String   @default("")
  seoDescription String   @default("")
  blocks         String   @default("[]") // JSON
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Redirect {
  id        Int      @id @default(autoincrement())
  from      String   @unique
  to        String
  code      Int      @default(301)
  active    Boolean  @default(true)
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingCity {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  fee       Int? // DH TTC, null = sur devis
  available Boolean  @default(true)
  delayText String   @default("")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Exceptions de frais de livraison par produit ou catégorie (Assigner Frais).
model FeeRule {
  id        Int      @id @default(autoincrement())
  scope     String // product | category
  target    String // référence produit ou slug de catégorie
  citySlug  String   @default("") // vide = toutes les villes
  mode      String   @default("fixed") // fixed | devis
  fee       Int      @default(0)
  note      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Paniers (paniers abandonnés). Coordonnées seulement si saisies au formulaire de commande.
model Cart {
  id          String    @id // jeton aléatoire du navigateur
  items       String // JSON [{ id, qty }]
  itemCount   Int       @default(0)
  subtotal    Int       @default(0)
  name        String?
  phone       String?
  email       String?
  status      String    @default("ouvert") // ouvert | relancé | récupéré | perdu
  orderNumber String?
  utmSource   String?
  utmCampaign String?
  remindedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
}

/// Événements first-party anonymes (entonnoir) : aucune IP, aucun identifiant persistant.
model Event {
  id        Int      @id @default(autoincrement())
  at        DateTime @default(now())
  type      String // view | product_view | add_to_cart | checkout | quote_request | order
  path      String?
  productId String?
  source    String?
  medium    String?
  campaign  String?
  sid       String? // identifiant de session aléatoire (sessionStorage)
  value     Int?

  @@index([at])
  @@index([type, at])
}
